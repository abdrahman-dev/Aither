{
  "name": "aither",
  "version": "0.1.0",
  "private": true,
  "description": "Urban Heat Intelligence & Heat-Aware Routing",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:web": "npm run dev -w @aither/web",
    "dev:api": "npm run dev -w @aither/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
