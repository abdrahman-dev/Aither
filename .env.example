# Copy this file to .env and fill in real values.
# Never commit real secrets.

# FortyGuard API configuration (backend only — never expose to the frontend)
FORTYGUARD_API_KEY=your_api_key_here
FORTYGUARD_BASE_URL=https://api.fortyguard.com

# OpenRouteService API (backend only — never expose to the frontend)
ORS_API_KEY=your_ors_api_key_here

# Backend server
PORT=3000

# Frontend — Aither backend base URL (the frontend never calls FortyGuard/ORS directly).
# This is a base URL only: the app appends paths such as /api/route-risk itself.
VITE_API_BASE_URL=http://localhost:3000